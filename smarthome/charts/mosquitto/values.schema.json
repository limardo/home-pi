{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "mosquitto",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "global": {
      "type": "object",
      "required": [
        "blackbox"
      ],
      "properties": {
        "blackbox": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "prober": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "prober"
          ]
        }
      }
    },
    "enabled": {
      "type": "boolean"
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "pullPolicy": {
          "type": "string",
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      },
      "required": [
        "repository",
        "pullPolicy"
      ]
    },
    "service": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
            "maxLength": 15
          },
          "port": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535
          },
          "protocol": {
            "type": "string",
            "enum": [
              "TCP",
              "UDP"
            ]
          }
        },
        "required": [
          "name",
          "port",
          "protocol"
        ]
      }
    },
    "users": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][-a-z0-9_.]*$"
      }
    },
    "resources": {
      "type": "object"
    },
    "nodeSelector": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "tolerations": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "startupProbe": {
      "type": "object"
    },
    "livenessProbe": {
      "type": "object"
    },
    "readinessProbe": {
      "type": "object"
    },
    "probe": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "url"
      ],
      "properties": {
        "url": {
          "type": "string"
        },
        "module": {
          "type": "string"
        }
      }
    }
  },
  "required": [
    "image",
    "service",
    "users",
    "resources",
    "nodeSelector",
    "tolerations",
    "startupProbe",
    "livenessProbe",
    "readinessProbe",
    "probe"
  ]
}
