{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "tvheadend",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "global": {
      "type": "object",
      "required": [
        "nfs",
        "gateway"
      ],
      "properties": {
        "nfs": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "server": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "server"
          ]
        },
        "gateway": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "namespace": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "name",
            "namespace"
          ]
        }
      }
    },
    "enabled": {
      "type": "boolean"
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "pullPolicy": {
          "type": "string",
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      },
      "required": [
        "repository",
        "pullPolicy"
      ]
    },
    "service": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
            "maxLength": 15
          },
          "port": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535
          },
          "protocol": {
            "type": "string",
            "enum": [
              "TCP",
              "UDP"
            ]
          }
        },
        "required": [
          "name",
          "port",
          "protocol"
        ]
      }
    },
    "hostnames": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "resources": {
      "type": "object"
    },
    "livenessProbe": {
      "type": "object"
    },
    "readinessProbe": {
      "type": "object"
    },
    "nfs": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^/"
        },
        "piconsPath": {
          "type": "string",
          "pattern": "^/"
        }
      },
      "required": [
        "path",
        "piconsPath"
      ]
    },
    "epg": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "urls": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^https?://"
          }
        },
        "schedule": {
          "type": "string",
          "minLength": 1
        },
        "image": {
          "type": "string",
          "minLength": 1
        },
        "resources": {
          "type": "object"
        }
      },
      "required": [
        "urls",
        "schedule",
        "image",
        "resources"
      ]
    },
    "nodeSelector": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "tolerations": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "probe": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "url"
      ],
      "properties": {
        "url": {
          "type": "string"
        },
        "module": {
          "type": "string"
        }
      }
    },
    "startupProbe": {
      "type": "object"
    },
    "backup": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schedule": {
          "type": "string",
          "minLength": 1
        },
        "retention": {
          "type": "integer",
          "minimum": 3
        },
        "nfsPath": {
          "type": "string",
          "pattern": "^/(.*/)?[Bb][Aa][Cc][Kk][Uu][Pp][Ss](/.*)?$"
        },
        "image": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "schedule",
        "retention",
        "nfsPath",
        "image"
      ]
    }
  },
  "required": [
    "image",
    "service",
    "hostnames",
    "resources",
    "livenessProbe",
    "readinessProbe",
    "nfs",
    "epg",
    "nodeSelector",
    "tolerations",
    "startupProbe",
    "backup"
  ]
}
