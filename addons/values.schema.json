{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "addons",
  "description": "Umbrella chart values: each subchart has its own values.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "global": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "nfs": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "server": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "server"
          ]
        },
        "blackbox": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "prober": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "prober"
          ]
        },
        "gateway": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "namespace": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "name",
            "namespace"
          ]
        }
      }
    },
    "storage": {
      "$ref": "#/definitions/subchart"
    },
    "security": {
      "$ref": "#/definitions/subchart"
    },
    "observability": {
      "$ref": "#/definitions/subchart"
    },
    "ingress": {
      "$ref": "#/definitions/subchart"
    },
    "databases": {
      "$ref": "#/definitions/subchart"
    }
  },
  "definitions": {
    "subchart": {
      "type": "object",
      "required": [
        "enabled"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      }
    }
  }
}
