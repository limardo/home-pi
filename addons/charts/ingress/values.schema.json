{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ingress",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "global": {
      "type": "object",
      "required": [
        "gateway"
      ],
      "properties": {
        "gateway": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "namespace": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "name",
            "namespace"
          ]
        }
      }
    },
    "enabled": {
      "type": "boolean"
    },
    "namespace": {
      "type": "string"
    },
    "charts": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/definitions/chart"
      }
    },
    "services": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "gatewayApi": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            }
          },
          "required": [
            "enabled"
          ]
        },
        "metallb": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "addressPool": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "addresses": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "autoAssign": {
                  "type": "boolean"
                }
              },
              "required": [
                "name",
                "addresses",
                "autoAssign"
              ]
            },
            "l2Advertisement": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "name"
              ]
            }
          },
          "required": [
            "enabled",
            "addressPool",
            "l2Advertisement"
          ]
        }
      }
    }
  },
  "definitions": {
    "chart": {
      "description": "Entry of .Values.charts: becomes a k0s Chart CR (addons.k0sChart)",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "name",
        "chart",
        "version"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "chart": {
          "type": "string",
          "minLength": 1
        },
        "repository": {
          "type": "string",
          "format": "uri"
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "config": {
          "type": "object"
        },
        "metrics": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            }
          },
          "required": [
            "enabled"
          ]
        },
        "gateway": {
          "description": "nginx-gateway-fabric Gateway: name and namespace come from global.gateway",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "spec"
          ],
          "properties": {
            "annotations": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            },
            "spec": {
              "type": "object"
            }
          }
        }
      },
      "if": {
        "properties": {
          "chart": {
            "pattern": "^oci://"
          }
        }
      },
      "else": {
        "required": [
          "repository"
        ]
      }
    }
  },
  "required": [
    "charts",
    "services"
  ]
}
