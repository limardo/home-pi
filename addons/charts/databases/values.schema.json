{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "databases",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "global": {
      "type": "object"
    },
    "enabled": {
      "type": "boolean"
    },
    "namespace": {
      "type": "string"
    },
    "charts": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/definitions/chart"
      }
    }
  },
  "definitions": {
    "chart": {
      "description": "Entry of .Values.charts: becomes a k0s Chart CR (addons.k0sChart)",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "name",
        "chart",
        "version"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "chart": {
          "type": "string",
          "minLength": 1
        },
        "repository": {
          "type": "string",
          "format": "uri"
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "config": {
          "type": "object"
        }
      },
      "if": {
        "properties": {
          "chart": {
            "pattern": "^oci://"
          }
        }
      },
      "else": {
        "required": [
          "repository"
        ]
      }
    }
  },
  "required": [
    "charts"
  ]
}
